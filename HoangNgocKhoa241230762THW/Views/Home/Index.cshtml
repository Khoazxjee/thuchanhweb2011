@model IEnumerable<Sach>

<div class="banner">
    <img src="~/images/banner.jpg" alt="BookHub" />
</div>

<div id="noiDungSach">
    <partial name="HoangNgocKhoa_MainContent" model="Model" />
</div>

@section Scripts {
    <script>
        $(function () {
            let request = null;

            $(".loc-the-loai").on("click", function (event) {
                event.preventDefault();

                const link = this;
                const url = $(link).attr("data-url");

                if (request) {
                    request.abort();
                }

                request = $.get(url)
                    .done(function (html) {
                        $("#noiDungSach").html(html);
                        $(".menu li").removeClass("active");
                        $(link).closest("li").addClass("active");
                    })
                    .fail(function (xhr, status) {
                        if (status !== "abort") {
                            alert("Không tải được danh sách sách.");
                        }
                    });
            });
        });
    </script>
}
